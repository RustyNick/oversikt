# Copy this file to .env and fill in your own values.
# Never commit .env to Git or share it with anyone (it's already in .gitignore).

# From https://dev.twitch.tv/console (see "Getting your Twitch keys" in README.md)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# The port the app runs on: http://localhost:3000
PORT=3000

# Who can reach the server. 127.0.0.1 = only your own computer (recommended).
# Use 0.0.0.0 only when the server must be reachable from elsewhere, e.g. a hosting service.
# The app has no login, so then anyone who finds the address can use it.
HOST=127.0.0.1

# Time of day (24h, the server's local time) when all bookmarked users are fetched
DAILY_FETCH_TIME=20:00

# How often (in minutes) to measure bookmarked users who are live.
# 0 = off (data is then only fetched with the button and once a day).
# Set to 5 or lower to get real max and average viewer numbers.
LIVE_POLL_MINUTES=0
